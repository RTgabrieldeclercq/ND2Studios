{
  "version": "1.0",
  "processing": {
    "normalized": false,
    "recipe": []
  },
  "analysis": {
    "pipeline": "Histogram Threshold Segmenter",
    "params": {
      "channel_name": "",
      "method": "hysteresis",
      "direction": "above",
      "bit_depth": 12,
      "strict": 160,
      "permissive": 80,
      "low": 50,
      "high": 500,
      "percentile_low": 5.0,
      "percentile_high": 95.0,
      "fraction_low": 0.3,
      "fraction_high": 1.5,
      "min_area": 2000,
      "max_area": 0,
      "opening_radius": 1,
      "closing_radius": 2,
      "min_hole_size": 50
    }
  },
  "results": {
    "selected_columns": [
      "segmentation_channel",
      "frame",
      "label_id",
      "area_um2",
      "delta_area_um2"
    ]
  }
}